# Make `npm install` (run by the preview platform on every sandbox
# re-provision) fast and resilient:
#   - prefer-offline: resolve as much as possible from the local npm cache
#     (warm ~1.4GB) instead of hitting the network; installs become near-
#     instant after the first provision, shrinking the window where the
#     preview panel shows "Dev server failed with exit code -1".
#   - audit=false / fund=false: skip network-dependent audit + funding
#     overhead that can stall or fail a cold provision install.
prefer-offline=true
audit=false
fund=false
