# ---------------------------------------------------------------------------
# AI Learning OS — Environment Configuration
# Copy this file to `.env` (frontend vars) and `.env.server` (backend vars).
# NEVER commit real keys.
# ---------------------------------------------------------------------------

# --- Frontend (Vite) -------------------------------------------------------
# Backend API URL. Vite proxies /api here in dev.
VITE_BACKEND_URL=http://localhost:8787

# Supabase (optional — used for the bright-data-proxy Edge Function path).
# The app boots without these; web fetching then requires the local backend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Backend (server/.env) -------------------------------------------------
# OpenAI-compatible provider settings. Works with OpenAI, Ollama, Groq,
# OpenRouter, LM Studio, etc. The key lives ONLY server-side.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Bright Data Browser API (WebSocket endpoint) for real browser research.
# Example: wss://brd.superproxy.io:9222
BRIGHTDATA_BROWSER_WS_URL=

# Direct-fetch fallback for research when Bright Data is unavailable.
# Disabled by default; set to 1 to allow plain HTTP fetches.
RESEARCH_ALLOW_DIRECT_FETCH=0

# Port for the local backend.
PORT=8787

# --- Optional: Supabase for the backend fallback path -----------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
