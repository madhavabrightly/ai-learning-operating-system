{
  "name": "ai-learning-os",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-first, event-driven learning workspace with a runtime pipeline engine, knowledge graph, learning assistant, and plugin system.",
  "type": "module",
  "scripts": {
    "dev": "vite optimize && vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev\"",
    "build": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"*.{ts,tsx,js,json}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/katex": "^0.16.8",
    "@types/react-window": "^1.8.8",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "idb-keyval": "^6.3.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.30.0",
    "mammoth": "^1.12.0",
    "openai": "^7.4.0",
    "pdfjs-dist": "^6.2.108",
    "playwright-core": "^1.63.0-alpha-2026-08-05",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^20.0.0",
    "react-error-boundary": "^6.1.2",
    "react-router-dom": "^7.18.2",
    "react-window": "^2.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.18",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
