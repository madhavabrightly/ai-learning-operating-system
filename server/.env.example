# Backend configuration for the AI Learning OS.
# Copy to server/.env and fill in real values. NEVER commit server/.env.

# OpenAI-compatible provider (works with OpenAI, Ollama, Groq, OpenRouter, LM Studio)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Bright Data Browser API (WebSocket endpoint) for real browser research
BRIGHTDATA_BROWSER_WS_URL=

# Allow plain HTTP fetch as a research fallback (1 to enable)
RESEARCH_ALLOW_DIRECT_FETCH=0

# Port for the backend
PORT=8787

# Optional Supabase fallback
SUPABASE_URL=
SUPABASE_ANON_KEY=
